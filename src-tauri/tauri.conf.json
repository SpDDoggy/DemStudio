{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEM Studio",
  "version": "0.12.1",
  "identifier": "studio.dem.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DEM Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Terrain visualization and DEM rendering studio",
    "longDescription": "DEM Studio imports elevation data, renders interactive terrain and exports georeferenced imagery."
  }
}
