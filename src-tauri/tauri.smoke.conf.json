{
  "identifier": "studio.dem.desktop.smoke.v2",
  "build": {
    "beforeBuildCommand": "node --preserve-symlinks-main node_modules/vite/bin/vite.js build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DEM Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --remote-debugging-port=9457"
      }
    ]
  },
  "bundle": {
    "active": false
  }
}
